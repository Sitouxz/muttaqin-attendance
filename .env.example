# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_JWT_SECRET=<jwt-secret>

# Resend
RESEND_API_KEY=re_<key>
RESEND_FROM_EMAIL=info@santunanemas.sg

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Santunan Emas

# OTP TTL (seconds)
OTP_TTL_SECONDS=600

# Cron security (Vercel cron jobs)
CRON_SECRET=<random-secret>

# Santunan Emas notification copies (client: SE keeps a copy of every QR sent)
SE_NOTIFY_EMAIL=info@santunanemas.sg

# WhatsApp registration route (Twilio) — same account/sender as the Muttaqin Chatbot.
# Leave TWILIO_QR_TEMPLATE_SID unset to keep WhatsApp delivery disabled.
NEXT_PUBLIC_WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=AC<key>
TWILIO_AUTH_TOKEN=<token>
TWILIO_WHATSAPP_NUMBER=whatsapp:+65XXXXXXXX
TWILIO_QR_TEMPLATE_SID=HX<content-template-sid>
SE_WHATSAPP_NOTIFY_NUMBER=+65XXXXXXXX

# WhatsApp inbound-first fallback (Path B — no template needed)
NEXT_PUBLIC_SE_WHATSAPP_NUMBER=6589913776
WA_CLAIM_SECRET=<shared-secret-with-the-chatbot-webhook>
